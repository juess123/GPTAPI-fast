# 复制本文件为 .env 后填入真实配置。.env 已被 .gitignore 忽略，不会被提交。
#
# 必填：CNXMAI_API_KEY / CNXMAI_CHAT_URL / CNXMAI_MODEL
# 缺失时 pipeline/ask_model.py 会直接退出并提示。

# 网关密钥
CNXMAI_API_KEY=

# 网关 API 根地址（一般用不到，保留备用）
CNXMAI_BASE_URL=

# Chat Completions 接口。注意：该网关的 /v1/responses 实测返回 404，必须用 chat/completions。
CNXMAI_CHAT_URL=https://api.qnaigc.com/v1/chat/completions

# 模型名称
CNXMAI_MODEL=

# 单次请求超时，支持 90 / 90s / 40m / 1.5h
CNXMAI_TIMEOUT=40m

# 单次回复最大 token 数
CNXMAI_MAX_TOKENS=320000

# 最大尝试次数（可选）
# CNXMAI_ATTEMPTS=2

# Web 服务监听地址与端口（可选；默认 0.0.0.0:8000）
# WEBAPP_HOST=127.0.0.1
# WEBAPP_PORT=9000

# 同时执行的任务数上限（可选；默认 2）
# WEBAPP_PARALLEL=2
